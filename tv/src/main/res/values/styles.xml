<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">#FAFAFA</item>
        <item name="android:alertDialogTheme">@style/Dialog</item>
    </style>
    <style name="Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog</item>
        <item name="android:colorAccent">#FAFAFA</item>
        <item name="android:textColorPrimary">#FAFAFA</item>
        <item name="android:textColorSecondary">#A1A1A1</item>
    </style>
    <style name="Tool">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/chip</item>
        <item name="android:tint">@color/chip_text</item>
        <item name="android:nextFocusDown">@id/web</item>
    </style>
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/chip</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
